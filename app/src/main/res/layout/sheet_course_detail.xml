<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="16dp"
    android:paddingBottom="20dp">

    <!-- 顶部课程色条（颜色在代码中按课程色着色，这里仅占位） -->
    <View
        android:id="@+id/sheet_color_bar"
        android:layout_width="48dp"
        android:layout_height="4dp"
        android:background="?attr/colorPrimary" />

    <TextView
        android:id="@+id/sheet_course_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textStyle="bold"
        tools:text="高等数学 A(一)" />

    <TextView
        android:id="@+id/sheet_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="?attr/textAppearanceTitleSmall"
        android:textColor="?attr/colorPrimary"
        tools:text="周三 · 第1-2节 · 08:00~09:40" />

    <TextView
        android:id="@+id/sheet_teacher"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        tools:text="教师：张三" />

    <TextView
        android:id="@+id/sheet_room"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        tools:text="地点：经信楼 A201" />

    <TextView
        android:id="@+id/sheet_weeks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        tools:text="周次：1-16周" />

    <TextView
        android:id="@+id/sheet_hidden_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorError"
        android:visibility="gone"
        tools:text="已隐藏 2 个周次"
        tools:visibility="visible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_edit"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/sheet_edit" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_delete"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/action_delete"
            android:textColor="?attr/colorError" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_hide_once"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/sheet_hide_once" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_hide_all"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sheet_hide_all" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_restore"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/sheet_restore"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
