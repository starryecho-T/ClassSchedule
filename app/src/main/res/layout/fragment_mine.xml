<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mine_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/tab_mine" android:textAppearance="?attr/textAppearanceHeadlineMedium" android:paddingBottom="20dp" />
        <TextView android:id="@+id/mine_version" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="?attr/colorOnSurfaceVariant" android:paddingBottom="16dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/mine_import" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/import_title" />
        <com.google.android.material.button.MaterialButton android:id="@+id/mine_hidden" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hidden_courses_title" />
        <com.google.android.material.button.MaterialButton android:id="@+id/mine_export" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/backup_export" />
        <com.google.android.material.button.MaterialButton android:id="@+id/mine_restore" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/backup_restore" />
        <com.google.android.material.button.MaterialButton android:id="@+id/mine_update" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/update_check" />
        <com.google.android.material.button.MaterialButton android:id="@+id/mine_theme" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/appearance_title" />
        <com.google.android.material.button.MaterialButton android:id="@+id/mine_github" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/github_project" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="4dp" android:text="@string/github_description" android:textColor="?attr/colorOnSurfaceVariant" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="4dp" android:text="@string/github_url" android:textIsSelectable="true" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp" />
        <ProgressBar android:id="@+id/backup_progress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:visibility="gone" android:contentDescription="@string/backup_busy" />
        <TextView android:id="@+id/backup_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityLiveRegion="polite" android:paddingTop="16dp" android:textColor="?attr/colorOnSurface" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
